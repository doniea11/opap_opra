/**
 * File ini berjalan di Server Node.js Vercel (bukan di browser pengguna).
 * Fungsinya sebagai "Jembatan Rahasia" agar Token & URL Apps Script tidak bocor ke publik.
 */
export default async function handler(req, res) {
  // Hanya izinkan metode POST
  if (req.method !== 'POST') {
    return res.status(405).json({ success: false, message: 'Method Not Allowed' });
  }

  // URL_APPS_SCRIPT dan API_TOKEN diambil dari pengaturan rahasia Dasbor Vercel
  const GAS_URL = process.env.URL_APPS_SCRIPT;
  const API_TOKEN = process.env.API_TOKEN;

  if (!GAS_URL || !API_TOKEN) {
    return res.status(500).json({ 
      success: false, 
      message: 'Server Error: Environment Variables belum disetting di Vercel.' 
    });
  }

  try {
    const requestBody = req.body;
    
    // Server Vercel menyisipkan token API secara diam-diam
    requestBody.token = API_TOKEN;

    const response = await fetch(GAS_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'text/plain', // Sesuai syarat CORS Apps Script
      },
      body: JSON.stringify(requestBody)
    });

    const data = await response.json();
    return res.status(200).json(data);

  } catch (error) {
    return res.status(500).json({ success: false, message: 'Gagal terhubung ke Database: ' + error.message });
  }
}
